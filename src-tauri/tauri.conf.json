{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XI Model Viewer",
  "version": "1.2.2",
  "identifier": "uk.co.viion.ximodelviewer",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XI Model Viewer",
        "width": 1500,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Vekien",
    "homepage": "https://github.com/vekien/xi-model-viewer",
    "category": "Graphics and Design",
    "shortDescription": "FFXI asset browser in a WebGL2 viewport",
    "longDescription": "Browse Final Fantasy XI's DAT files as models rather than bytes: zones, NPCs and monsters, playable characters with equipment and animations, spell effects, textures, music and sound effects, and the client's record tables. Exports to GLB and FBX.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
