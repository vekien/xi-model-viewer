{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XI Model Viewer",
  "version": "1.0.1",
  "identifier": "uk.co.viion.ximodelviewer",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XI Model Viewer",
        "width": 1500,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
